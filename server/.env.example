# Copy to .env — never commit a real .env with keys.
PORT=3000
# AI: gemini | openai | local | stub (default stub — no keys needed)
AI_PROVIDER=stub
# Voice: kokoro | google | elevenlabs | local | stub (default stub)
VOICE_PROVIDER=stub
# Gemini (AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# OpenAI-compatible (AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Local LLM + Whisper + Kokoro (AI_PROVIDER=local, VOICE_PROVIDER=local)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1
WHISPER_URL=http://localhost:8080
KOKORO_URL=http://localhost:8880
KOKORO_VOICE=af_heart
# Google Cloud TTS (VOICE_PROVIDER=google)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=
# ElevenLabs (VOICE_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Progress: Postgres/Supabase connection string. If empty, uses a local JSON file.
DATABASE_URL=
# Progress file when DATABASE_URL is empty (default: server/data/progress.json)
PROGRESS_FILE=
