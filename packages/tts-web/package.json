{
  "name": "@patotalk/tts-web",
  "version": "0.1.0",
  "description": "Browser audio for Pato Talk: mic recording for multimodal LLM input, and TTS output (Supertonic 3, Web Speech).",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@patotalk/core": "0.1.0",
    "@yomiscript/supertonic": "0.1.0",
    "onnxruntime-web": "1.22.0"
  },
  "scripts": {
    "build:browser": "esbuild src/engines.ts --bundle --format=esm --platform=browser --alias:@patotalk/core=../core/src/tts.ts --external:onnxruntime-web --external:@yomiscript/supertonic --outfile=browser/tts-web.js"
  }
}
