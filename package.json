{
  "name": "patotalk-open-framework",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "npm -w @patotalk/core test",
    "selftest": "tsx scripts/selftest.ts",
    "web": "npm -w @patotalk/web run dev",
    "build:web": "npm -w @patotalk/web run build",
    "typecheck": "tsc -p packages/core && tsc -p packages/tts-web && tsc -p apps/web --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0"
  }
}
